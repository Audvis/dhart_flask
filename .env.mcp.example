# MCP Server Configuration Example
# Copy this file to .env and fill in your values

# Backend URL - Where your Flask API is running
BACKEND_URL=http://localhost:5000

# WooCommerce Configuration (same as main backend)
WC_STORE_URL=https://your-store.com
WC_CONSUMER_KEY=your_consumer_key_here
WC_CONSUMER_SECRET=your_consumer_secret_here

# Optional: Frontend URL for CORS (if needed)
FRONTEND_URL=http://localhost:3000
